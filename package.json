{
  "name": "mist",
  "version": "1.0.0",
  "description": "股票市场分析和预警系统 - A-share market analysis and alert system with AI-powered intelligent agents",
  "author": "moyui",
  "private": true,
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "mist": "dist/apps/mist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "build:docker": "nest build mist && nest build schedule && nest build backtest && nest build chan && nest build signal && nest build realtime-subscription-hil && nest build notification",
    "build:hil": "nest build realtime-subscription-hil",
    "db:migrate": "node tools/run-migrations.mjs",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:mist": "nest start mist",
    "start:dev:chan": "nest start chan",
    "start:dev:signal": "nest start signal",
    "start:dev:backtest": "nest start backtest",
    "start:dev:notification": "nest start notification",
    "start:debug": "nest start --debug --watch",
    "start:debug:chan": "nest start chan --debug --watch",
    "start:prod": "node dist/apps/mist/main",
    "hil:realtime-subscriptions": "node dist/apps/realtime-subscription-hil/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand --watchman=false --forceExit",
    "ci:contracts": "node tools/test-ci-contracts.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:coverage": "jest --coverage --runInBand --watchman=false --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "10.4.15",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.7.9",
    "body-parser": "^2.2.2",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^3.5.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.0.2",
    "mysql2": "^3.12.0",
    "nestjs-pino": "^4.6.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "technicalindicators": "3.1.0",
    "typeorm": "^0.3.20",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.2.7",
    "pino": "^10",
    "pkg": "^5.8.1",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "clearMocks": true,
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/main.ts",
      "!**/*.config.*",
      "!**/.eslintrc.js",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.interface.ts",
      "!**/*.types.ts",
      "!**/*.enum.ts",
      "!**/*.constants.ts",
      "!**/dto/index.ts"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text-summary",
      "lcov",
      "clover",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 82.72,
        "statements": 81.64,
        "functions": 78.47,
        "branches": 67.9
      }
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/apps/test/jest-env.ts"
    ],
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/utils(|/.*)$": "<rootDir>/libs/utils/src/$1",
      "^@app/timezone(|/.*)$": "<rootDir>/libs/timezone/src/$1",
      "^@app/shared-data(|/.*)$": "<rootDir>/libs/shared-data/src/$1",
      "^@app/constants(|/.*)$": "<rootDir>/libs/constants/src/$1",
      "^@app/transport/http$": "<rootDir>/libs/transport/src/http/index.ts",
      "^@app/transport/rpc$": "<rootDir>/libs/transport/src/rpc/index.ts",
      "^@app/backtest$": "<rootDir>/libs/backtest/src/index.ts",
      "^@app/signal$": "<rootDir>/libs/signal/src/index.ts",
      "^@app/strategy$": "<rootDir>/libs/strategy/src/index.ts",
      "^@app/chancore$": "<rootDir>/libs/chancore/src/index.ts",
      "^@app/decimal$": "<rootDir>/libs/decimal/src/index.ts",
      "^@app/realtime$": "<rootDir>/libs/realtime/src/index.ts",
      "^@app/indicators$": "<rootDir>/libs/indicators/src/index.ts",
      "^@app/observability(|/.*)$": "<rootDir>/libs/observability/src/$1"
    }
  },
  "pkg": {
    "scripts": [
      "dist/apps/mist/main.js"
    ],
    "assets": [
      "node_modules/**/*"
    ]
  }
}
