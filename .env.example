# ===== Node Environment =====
NODE_ENV=development

# ===== MySQL =====
mysql_server_host=localhost
mysql_server_port=3306
mysql_server_username=root
mysql_server_password=your_password_here
mysql_server_database=mist

# ===== Redis =====
redis_server_host=localhost
redis_server_port=6379
redis_server_db=0

# ===== Data Source =====
# ef=EastMoney, tdx=TongDaXin, qmt=大QMT
DEFAULT_DATA_SOURCE=tdx

# TDX Data Source Configuration
# Base URL for mist-datasource service (TongDaXin bridge)
# Local development: http://127.0.0.1:9001
# Production Compose: http://tdx-datasource:9001
TDX_BASE_URL=http://127.0.0.1:9001

# QMT Data Source Configuration
# Base URL for mist-qmt-datasource service (full QMT bridge)
# Local development: http://127.0.0.1:9002
# Production Compose: http://qmt-datasource:9002
QMT_BASE_URL=http://127.0.0.1:9002

# TDX/QMT builtin realtime are the defaults. Set one source to off only for an
# explicit whole-chain rollback; allowlists independently control subscriptions.
TDX_WS_CLIENT_ID=mist-backend-tdx
TDX_WS_RECONNECT_DELAY_MS=5000
TDX_WS_HEARTBEAT_INTERVAL_MS=30000
TDX_REALTIME_MODE=builtin
TDX_REALTIME_ALLOWLIST=
QMT_WS_CLIENT_ID=mist-backend-qmt
QMT_WS_RECONNECT_DELAY_MS=5000
QMT_REALTIME_MODE=builtin
QMT_REALTIME_ALLOWLIST=

# ===== AKTools =====
AKTOOLS_BASE_URL=http://localhost:8080

# ===== App Ports =====
# Ports are NOT set in shared .env. Each app uses its hardcoded default
# in main.ts (process.env.PORT ?? <default>). Docker overrides per-service
# via docker-compose.yml environment section.
# To override locally, set PORT env var when starting: PORT=8002 pnpm run start:dev:saya

# ===== LLM (saya only) =====
REASONING_API_KEY=
REASONING_BASE_URL=
REASONING_MODEL=
FAST_API_KEY=
FAST_BASE_URL=
FAST_MODEL=
VL_API_KEY=
VL_BASE_URL=
VL_MODEL=
TAVILY_API_KEY=

# ===== Saya Settings =====
DEBUG=false
APP_ENV=development

# ===== Docker Deployment =====
REPO_OWNER=moyui
VERSION=latest
